{
  "name": "senddocu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "lint": "node -c server.js",
    "preflight": "node scripts/preflight.js",
    "schema:verify": "node scripts/schema.verify.js",
    "start": "node server.js",
    "start:prod": "npm run lint && npm run preflight && npm run schema:verify && pm2 start server.js --name senddocu-backend",
    "restart:prod": "pm2 restart senddocu-backend --update-env",
    "stop:prod": "pm2 stop senddocu-backend",
    "logs": "pm2 logs senddocu-backend",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^9.39.2"
  }
}
